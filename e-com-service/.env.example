GOOGLE_API_KEY=

# Data source for KB build
FOLDER_DATA_BUILD_KB=data

# Embedding request throttling
KB_EMBEDDING_BATCH_SIZE=100
KB_EMBEDDING_REQUEST_DELAY_SECONDS=60
KB_EMBEDDING_MAX_RETRIES=5

# Retriever backend: postgres or json
KB_RETRIEVER_BACKEND=postgres

# Search-service endpoint for product lookup
SEARCH_SERVICE_URL=http://localhost:8001/search
SEARCH_SERVICE_TIMEOUT_SECONDS=5
SEARCH_SERVICE_MAX_PAGE_SIZE=50

# Postgres pgvector
POSTGRES_URL=postgresql://kb_user:kb_password@localhost:5432/kb_db
KB_VECTOR_TABLE=kb_embeddings
KB_EMBEDDING_DIMENSION=3072
